# --- Trascrizione (Groq Whisper) ---
GROQ_API_KEY=

# --- Riscrittura (Anthropic) ---
ANTHROPIC_API_KEY=
# Modello usato per la riscrittura. Sonnet-tier va bene (costa centesimi).
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Storage (Supabase) ---
SUPABASE_URL=
# Usare la SERVICE key (lato server) per bypassare la RLS.
SUPABASE_SERVICE_KEY=

# --- Opzionale ---
# CORS: origine del frontend PWA. "*" per test, poi metti l'URL Vercel.
CORS_ORIGINS=*
# yt-dlp: cookie Instagram (sblocca i reel che richiedono login).
#  - opzione A: percorso a un file cookies.txt
YTDLP_COOKIES_FILE=
#  - opzione B (comoda su Render): incolla qui TUTTO il contenuto del cookies.txt
YTDLP_COOKIES_CONTENT=
# Modello Whisper su Groq.
GROQ_WHISPER_MODEL=whisper-large-v3
