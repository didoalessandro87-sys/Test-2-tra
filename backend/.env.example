# --- Trascrizione (Groq Whisper) ---
GROQ_API_KEY=

# --- Riscrittura (Anthropic) ---
ANTHROPIC_API_KEY=
# Modello usato per la riscrittura. Sonnet-tier va bene (costa centesimi).
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Storage (Supabase) ---
SUPABASE_URL=
# Usare la SERVICE key (lato server) per bypassare la RLS.
SUPABASE_SERVICE_KEY=

# --- Opzionale ---
# CORS: origine del frontend PWA. "*" per test, poi metti l'URL Vercel.
CORS_ORIGINS=*
# yt-dlp: percorso a un file cookies.txt se Instagram chiede login (vedi §11 del brief).
YTDLP_COOKIES_FILE=
# Modello Whisper su Groq.
GROQ_WHISPER_MODEL=whisper-large-v3
